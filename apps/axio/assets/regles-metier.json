[
  {
    "id": "tache-changement-recalcule-projet",
    "typeId": "tache",
    "then": [
      { "effect": "dispatchEvent", "field": "projetId", "targetType": "projet", "eventType": "projet.recompute_suivi" }
    ]
  },
  {
    "id": "projet-recalcule-suivi",
    "typeId": "projet",
    "eventType": "projet.recompute_suivi",
    "then": [
      {
        "effect": "countRelated",
        "relationType": "tache",
        "matchField": "projetId",
        "as": "nbTachesTotal"
      },
      { "effect": "setField", "field": "tachesTotal", "value": "$nbTachesTotal" },
      {
        "effect": "countRelated",
        "relationType": "tache",
        "matchField": "projetId",
        "filter": { "field": "statut", "equals": "Terminée" },
        "as": "nbTachesTerminees"
      },
      { "effect": "setField", "field": "tachesTerminees", "value": "$nbTachesTerminees" },
      {
        "effect": "setField",
        "field": "avancement",
        "value": {
          "if": { "field": "tachesTotal", "equals": "0" },
          "then": "0%",
          "else": {
            "concat": [
              {
                "round": {
                  "multiply": [
                    { "round": { "divide": [{ "multiply": ["$nbTachesTerminees", "4"] }, "$nbTachesTotal"] } },
                    "25"
                  ]
                }
              },
              "%"
            ]
          }
        }
      }
    ]
  }
]
