[
    {
        "id": "passage-changement-recalcule-client",
        "typeId": "passage",
        "then": [
            { "effect": "dispatchEvent", "field": "clientId", "targetType": "client", "eventType": "client.recompute_counts" }
        ]
    },
    {
        "id": "client-recalcule-compteurs",
        "typeId": "client",
        "eventType": "client.recompute_counts",
        "then": [
            {
                "effect": "countRelated",
                "relationType": "passage",
                "matchField": "clientId",
                "filter": { "field": "statut", "equals": "Réalisée" },
                "as": "nbRealisees"
            },
            { "effect": "setField", "field": "nbInterventionsRealisees", "value": "$nbRealisees" },
            {
                "effect": "sumRelated",
                "relationType": "passage",
                "matchField": "clientId",
                "filter": { "field": "statut", "equals": "Réalisée" },
                "sourceField": "montant",
                "as": "totalRealise"
            },
            { "effect": "setField", "field": "totalRealise", "value": "$totalRealise" }
        ]
    },
    {
        "id": "passage-calcule-montant",
        "typeId": "passage",
        "when": {
            "and": [
                { "field": "dureeReelle", "empty": false },
                { "or": [
                    { "field": "dureeReelle", "changed": true },
                    { "field": "tarifId", "changed": true }
                ] }
            ]
        },
        "then": [
            { "effect": "viaFk", "field": "tarifId", "targetType": "tarif", "read": "montantHoraire", "as": "tauxHoraire" },
            { "effect": "setField", "field": "montant", "value": { "multiply": ["@dureeReelle", "$tauxHoraire"] } }
        ]
    },
    {
        "id": "passage-duree-vers-fin",
        "typeId": "passage",
        "when": {
            "and": [
                { "field": "dureePrevue", "changed": true },
                { "field": "debutPrevu", "empty": false }
            ]
        },
        "then": [
            { "effect": "setField", "field": "finPrevue", "value": { "addHours": ["@debutPrevu", "@dureePrevue"] } }
        ]
    },
    {
        "id": "passage-fin-vers-duree",
        "typeId": "passage",
        "when": {
            "and": [
                { "field": "finPrevue", "changed": true },
                { "field": "debutPrevu", "empty": false }
            ]
        },
        "then": [
            { "effect": "setField", "field": "dureePrevue", "value": { "diffHours": ["@finPrevue", "@debutPrevu"] } }
        ]
    },
    {
        "id": "passage-facture-changee",
        "typeId": "passage",
        "when": { "field": "factureId", "empty": false },
        "then": [
            { "effect": "dispatchEvent", "field": "factureId", "targetType": "facture", "eventType": "facture.recompute" }
        ]
    },
    {
        "id": "facture-recalcule-montant",
        "typeId": "facture",
        "eventType": "facture.recompute",
        "then": [
            {
                "effect": "sumRelated",
                "relationType": "passage",
                "matchField": "factureId",
                "sourceField": "montant",
                "as": "sommeFacture"
            },
            { "effect": "setField", "field": "montantTotal", "value": "$sommeFacture" }
        ]
    },
    {
        "id": "contrat-genere-passages",
        "typeId": "contrat",
        "eventType": "contrat.action:genererPassages",
        "then": [
            {
                "effect": "generateRecords",
                "targetType": "passage",
                "sourceRelation": { "relationType": "contratCreneau", "matchFields": ["contratId"] },
                "repeat": "$weeks",
                "fields": {
                    "clientId": "%clientId",
                    "contratId": "%id",
                    "tarifId": "%tarifId",
                    "statut": "Planifiée",
                    "debutPrevu": { "concat": [
                        { "weekdayOccurrence": { "anchor": "%dateDebut", "weekday": "@jour", "week": "$week" } },
                        "T", "@heureDebut"
                    ] },
                    "finPrevue": { "addHours": [
                        { "concat": [
                            { "weekdayOccurrence": { "anchor": "%dateDebut", "weekday": "@jour", "week": "$week" } },
                            "T", "@heureDebut"
                        ] },
                        "@duree"
                    ] },
                    "dureePrevue": "@duree"
                }
            }
        ]
    },
    {
        "id": "client-envoyer-email",
        "typeId": "client",
        "eventType": "client.action:envoyerEmail",
        "then": [
            {
                "effect": "sendEmail",
                "destinataireField": "email",
                "modeleId": "$modeleEmailId",
                "objetSimple": "$objet",
                "corpsSimple": "$corps",
                "expediteur": "$expediteur"
            }
        ]
    },
    {
        "id": "client-poser-rappel",
        "typeId": "client",
        "eventType": "client.action:poserRappel",
        "then": [
            {
                "effect": "createRecord",
                "targetType": "rappel",
                "fields": {
                    "dateRappel": "$dateRappel",
                    "message": "$message",
                    "destinataire": "$destinataire",
                    "statut": "attente",
                    "cibleTypeId": "client",
                    "cibleId": "%id",
                    "cibleTitre": "%nom"
                }
            }
        ]
    },
    {
        "id": "passage-poser-rappel",
        "typeId": "passage",
        "eventType": "passage.action:poserRappel",
        "then": [
            {
                "effect": "createRecord",
                "targetType": "rappel",
                "fields": {
                    "dateRappel": "$dateRappel",
                    "message": "$message",
                    "destinataire": "$destinataire",
                    "statut": "attente",
                    "cibleTypeId": "passage",
                    "cibleId": "%id",
                    "cibleTitre": {
                        "concat": [
                            "Passage du ",
                            {
                                "substring": "%debutPrevu",
                                "start": 8,
                                "length": 2
                            },
                            "/",
                            {
                                "substring": "%debutPrevu",
                                "start": 5,
                                "length": 2
                            },
                            "/",
                            {
                                "substring": "%debutPrevu",
                                "start": 0,
                                "length": 4
                            }
                        ]
                    }
                }
            }
        ]
    },
    {
        "id": "facture-poser-rappel",
        "typeId": "facture",
        "eventType": "facture.action:poserRappel",
        "then": [
            {
                "effect": "createRecord",
                "targetType": "rappel",
                "fields": {
                    "dateRappel": "$dateRappel",
                    "message": "$message",
                    "destinataire": "$destinataire",
                    "statut": "attente",
                    "cibleTypeId": "facture",
                    "cibleId": "%id",
                    "cibleTitre": {
                        "concat": [
                            "Facture du ",
                            {
                                "substring": "%periodeDebut",
                                "start": 8,
                                "length": 2
                            },
                            "/",
                            {
                                "substring": "%periodeDebut",
                                "start": 5,
                                "length": 2
                            },
                            "/",
                            {
                                "substring": "%periodeDebut",
                                "start": 0,
                                "length": 4
                            }
                        ]
                    }
                }
            }
        ]
    },
    {
        "id": "rappel-echeance-email",
        "typeId": "rappel",
        "eventType": "rappel.echeance",
        "then": [
            {
                "effect": "sendEmail",
                "destinataireField": "destinataire",
                "objetSimple": {
                    "concat": [
                        "Rappel : ",
                        "%message"
                    ]
                },
                "corpsSimple": {
                    "concat": [
                        "Rappel prévu le ",
                        {
                            "substring": "%dateRappel",
                            "start": 8,
                            "length": 2
                        },
                        "/",
                        {
                            "substring": "%dateRappel",
                            "start": 5,
                            "length": 2
                        },
                        "/",
                        {
                            "substring": "%dateRappel",
                            "start": 0,
                            "length": 4
                        },
                        " à ",
                        {
                            "substring": "%dateRappel",
                            "start": 11,
                            "length": 5
                        },
                        " :\n\n",
                        "%message",
                        "\n\nFiche concernée : ",
                        "%cibleTitre",
                        "\nhttps://nexo.vivalink.top/\n"
                    ]
                },
                "expediteur": "noreply@vivalink.top"
            }
        ]
    },
    {
        "id": "rappel-notification",
        "typeId": "rappel",
        "eventType": "rappel.echeance",
        "then": [
            {
                "effect": "createRecord",
                "targetType": "notification",
                "fields": {
                    "titre": "%message",
                    "message": {
                        "concat": [
                            "Rappel prévu le ",
                            {
                                "substring": "%dateRappel",
                                "start": 8,
                                "length": 2
                            },
                            "/",
                            {
                                "substring": "%dateRappel",
                                "start": 5,
                                "length": 2
                            },
                            "/",
                            {
                                "substring": "%dateRappel",
                                "start": 0,
                                "length": 4
                            },
                            " à ",
                            {
                                "substring": "%dateRappel",
                                "start": 11,
                                "length": 5
                            },
                            "\n",
                            {
                                "if": {
                                    "field": "cibleTitre",
                                    "empty": false
                                },
                                "then": {
                                    "concat": [
                                        "Fiche : ",
                                        "%cibleTitre"
                                    ]
                                },
                                "else": ""
                            }
                        ]
                    },
                    "dateNotif": "%dateRappel",
                    "lu": "",
                    "cibleTypeId": "%cibleTypeId",
                    "cibleId": "%cibleId"
                }
            }
        ]
    }
]
