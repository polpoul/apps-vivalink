[
    {
        "id": "passage-changement-recalcule-client",
        "typeId": "passage",
        "then": [
            { "effect": "dispatchEvent", "field": "clientId", "targetType": "client", "eventType": "client.recompute_counts" }
        ]
    },
    {
        "id": "client-recalcule-compteurs",
        "typeId": "client",
        "eventType": "client.recompute_counts",
        "then": [
            {
                "effect": "countRelated",
                "relationType": "passage",
                "matchField": "clientId",
                "filter": { "field": "statut", "equals": "Réalisée" },
                "as": "nbRealisees"
            },
            { "effect": "setField", "field": "nbInterventionsRealisees", "value": "$nbRealisees" },
            {
                "effect": "sumRelated",
                "relationType": "passage",
                "matchField": "clientId",
                "filter": { "field": "statut", "equals": "Réalisée" },
                "sourceField": "montant",
                "as": "totalRealise"
            },
            { "effect": "setField", "field": "totalRealise", "value": "$totalRealise" }
        ]
    },
    {
        "id": "passage-calcule-montant",
        "typeId": "passage",
        "when": {
            "and": [
                { "field": "dureeReelle", "empty": false },
                { "or": [
                    { "field": "dureeReelle", "changed": true },
                    { "field": "tarifId", "changed": true }
                ] }
            ]
        },
        "then": [
            { "effect": "viaFk", "field": "tarifId", "targetType": "tarif", "read": "montantHoraire", "as": "tauxHoraire" },
            { "effect": "setField", "field": "montant", "value": { "multiply": ["@dureeReelle", "$tauxHoraire"] } }
        ]
    },
    {
        "id": "passage-duree-vers-fin",
        "typeId": "passage",
        "when": {
            "and": [
                { "field": "dureePrevue", "changed": true },
                { "field": "debutPrevu", "empty": false }
            ]
        },
        "then": [
            { "effect": "setField", "field": "finPrevue", "value": { "addHours": ["@debutPrevu", "@dureePrevue"] } }
        ]
    },
    {
        "id": "passage-fin-vers-duree",
        "typeId": "passage",
        "when": {
            "and": [
                { "field": "finPrevue", "changed": true },
                { "field": "debutPrevu", "empty": false }
            ]
        },
        "then": [
            { "effect": "setField", "field": "dureePrevue", "value": { "diffHours": ["@finPrevue", "@debutPrevu"] } }
        ]
    },
    {
        "id": "passage-facture-changee",
        "typeId": "passage",
        "when": { "field": "factureId", "empty": false },
        "then": [
            { "effect": "dispatchEvent", "field": "factureId", "targetType": "facture", "eventType": "facture.recompute" }
        ]
    },
    {
        "id": "facture-recalcule-montant",
        "typeId": "facture",
        "eventType": "facture.recompute",
        "then": [
            {
                "effect": "sumRelated",
                "relationType": "passage",
                "matchField": "factureId",
                "sourceField": "montant",
                "as": "sommeFacture"
            },
            { "effect": "setField", "field": "montantTotal", "value": "$sommeFacture" }
        ]
    }
]
