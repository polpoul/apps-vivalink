            }
        ]
    },
    {
        "id": "personne-decede-vide-contact",
        "typeId": "personne",
        "when": {
            "field": "decede",
            "equals": "true"
        },
        "then": [
            {
                "effect": "clearField",
                "field": "email"
            },
            {
                "effect": "clearField",
                "field": "emailPro"
            },
            {
                "effect": "clearField",
                "field": "mobile"
            }
        ]
    },
    {
        "id": "personne-creation-cree-foyer",
        "typeId": "personne",
        "when": {
            "field": "foyerId",
            "equals": ""
        },
        "then": [
            {
                "effect": "createRecord",
                "targetType": "foyer",
                "as": "nouveauFoyer"
            },
            {
                "effect": "copyField",
                "sourceField": "nom",
                "targetRef": "$nouveauFoyer",
                "targetField": "nom"
            },
            {
                "effect": "setField",
                "field": "foyerId",
                "value": "$nouveauFoyer"
            },
            {
                "effect": "createRecord",
                "targetType": "liaison",
                "as": "nouvelleLiaison"
            },
            {
                "effect": "copyField",
                "value": "$nouveauFoyer",
                "targetRef": "$nouvelleLiaison",
                "targetField": "foyerId"
            },
            {
                "effect": "copyField",
                "sourceField": "id",
                "targetRef": "$nouvelleLiaison",
                "targetField": "personneId"
            },
            {
                "effect": "copyField",
                "value": "Principal",
                "targetRef": "$nouvelleLiaison",
                "targetField": "statut"
            },
            {
                "effect": "copyField",
                "sourceField": "roleFoyer",
                "targetRef": "$nouvelleLiaison",
                "targetField": "role"
            }
        ]
    },
    {
        "id": "personne-changement-recalcule-foyer",
        "typeId": "personne",
        "then": [
            {
                "effect": "dispatchEvent",
                "field": "foyerId",
                "targetType": "foyer",
                "eventType": "foyer.recompute_counts"
            }
        ]
    },
    {
        "id": "don-changement-recalcule-foyer",
        "typeId": "don",
        "then": [
            {
                "effect": "dispatchEvent",
                "field": "foyerId",
                "targetType": "foyer",
                "eventType": "foyer.recompute_counts"
            }
        ]
    },
    {
        "id": "foyer-recalcule-effectifs",
        "typeId": "foyer",
        "eventType": "foyer.recompute_counts",
        "then": [
            {
                "effect": "countRelated",
                "relationType": "personne",
                "matchField": "foyerId",
                "as": "totalCount"
            },
            {
                "effect": "setField",
                "field": "nbPersonnes",
                "value": "$totalCount"
            },
            {
                "effect": "countRelated",
                "relationType": "personne",
                "matchField": "foyerId",
                "filter": { "field": "roleFoyer", "equals": "Enfant" },
                "as": "enfantsCount"
            },
            {
                "effect": "setField",
                "field": "nbEnfants",
                "value": "$enfantsCount"
            },
            {
                "effect": "countRelated",
                "relationType": "don",
                "matchField": "foyerId",
                "as": "donsCount"
            },
            {
                "effect": "setField",
                "field": "nbDons",
                "value": "$donsCount"
            },
            {
                "effect": "existsRelated",
                "relationType": "personne",
                "matchField": "foyerId",
                "filter": { "field": "decede", "equals": "true" },
                "as": "unDecede"
            },
            {
                "effect": "setField",
                "field": "alerteDeces",
                "value": "$unDecede"
            },
            {
                "effect": "sumRelated",
                "relationType": "don",
                "matchField": "foyerId",
                "sourceField": "montant",
                "as": "sommeDons"
            },
            {
                "effect": "setField",
                "field": "totalDons",
                "value": "$sommeDons"
            }
        ]
    },
    {
        "id": "foyer-envoi-recu-fiscal-defaut",
        "typeId": "foyer",
        "when": { "field": "envoiRecuFiscal", "empty": true },
        "then": [
            {
                "effect": "setField",
                "field": "envoiRecuFiscal",
                "value": {
                    "if": { "field": "email", "empty": false },
                    "then": "Par email",
                    "else": "Par courrier"
                }
            }
        ]
    },
    {
        "id": "foyer-formule-politesse-depuis-civilite",
        "typeId": "foyer",
        "when": { "field": "civilite", "changed": true },
        "then": [
            {
                "effect": "setField",
                "field": "formulePolitesse",
                "value": {
                    "lookup": "civilite",
                    "table": {
                        "M.": "Cher Monsieur,",
                        "Mme": "Chère Madame,",
                        "Mlle": "Chère Madame,",
                        "M. et Mme": "Cher Monsieur, chère Madame,"
                    },
                    "default": ""
                }
            }
        ]
    },
    {
        "id": "foyer-nom2-recopie-nom1",
        "typeId": "foyer",
        "when": {
            "and": [
                { "field": "nom2", "empty": true },
                { "field": "nom1", "empty": false }
            ]
        },
        "then": [
            { "effect": "setField", "field": "nom2", "value": "@nom1" }
        ]
    },
    {
        "id": "personne-date-deces-force-decede",
        "typeId": "personne",
        "when": {
            "and": [
                { "field": "dateDeces", "empty": false },
                { "field": "decede", "equals": "false" }
            ]
        },
        "then": [
            { "effect": "setField", "field": "decede", "value": "true" }
        ]
    },
    {
        "id": "personne-preference-renseignee",
        "typeId": "personne",
        "when": { "field": "envoiRecuFiscal", "changed": true },
        "then": [
            {
                "effect": "setField",
                "field": "preferenceRenseignee",
                "value": { "if": { "field": "envoiRecuFiscal", "empty": false }, "then": "true", "else": "false" }
            }
        ]
    },
    {
        "id": "personne-envoi-recu-fiscal-defaut",
        "typeId": "personne",
        "when": { "field": "envoiRecuFiscal", "empty": true },
        "then": [
            {
                "effect": "setField",
                "field": "envoiRecuFiscal",
                "value": { "if": { "field": "email", "empty": false }, "then": "Par email", "else": "Par courrier" }
            }
        ]
    },
    {
        "id": "personne-formule-politesse-depuis-civilite",
        "typeId": "personne",
        "when": { "field": "civilite", "changed": true },
        "then": [
            {
                "effect": "setField",
                "field": "formulePolitesse",
                "value": {
                    "lookup": "civilite",
                    "table": { "M.": "Cher Monsieur,", "Mme": "Chère Madame,", "Mlle": "Chère Madame," },
                    "default": ""
                }
            }
        ]
    },
    {
        "id": "personne-sexe-depuis-civilite",
        "typeId": "personne",
        "when": { "field": "civilite", "in": ["M.", "Mme", "Mlle"] },
        "then": [
            {
                "effect": "setField",
                "field": "sexe",
                "value": {
                    "lookup": "civilite",
                    "table": { "M.": "M", "Mme": "F", "Mlle": "F" },
                    "default": ""
                }
            }
        ]
    },
    {
