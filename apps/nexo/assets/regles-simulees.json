        "then": [
            {
                "effect": "forEachRelated",
                "relationType": "liaison",
                "matchFields": ["foyerId", "personneId"],
                "excludeSelf": true,
                "then": [
                    { "effect": "delete" }
                ]
            }
        ]
    },
    {
