    {
        "id": "liaison-unicite-principal",
        "typeId": "liaison",
        "when": { "field": "statut", "equals": "Principal" },
        "then": [
            {
                "effect": "forEachRelated",
                "relationType": "liaison",
                "matchFields": ["personneId"],
                "filter": { "field": "statut", "equals": "Principal" },
                "excludeSelf": true,
                "then": [
                    { "effect": "setField", "field": "statut", "value": "Secondaire" }
